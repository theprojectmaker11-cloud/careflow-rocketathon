# ---- OpenRouter, via its OpenAI-compatible endpoint
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers, sent to OpenRouter on every request.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Aikti

# Roles are split on purpose: the fast model writes the answer, the stronger
# model makes the safety calls. Override any of these per deployment.
OPENROUTER_ASSISTANT_MODEL=qwen/qwen3.8-flash
OPENROUTER_SAFETY_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_VISION_MODEL=qwen/qwen3.8-flash
MODEL_TIMEOUT=120

# ---- Embeddings for pgvector, on a separate provider
# OpenRouter proxies chat/completions only and serves no embedding models, so
# retrieval needs its own endpoint. SiliconFlow has a free tier; grab a key at
# https://cloud.siliconflow.cn
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Must match the pgvector column width in the migrations. Qwen3-Embedding
# supports Matryoshka truncation to 64/128/256/512/768/1024/1536/2048/2560/4096.
# Changing the width means editing vector(1536) in all three migration files.
EMBEDDING_DIMENSIONS=1536
# Provider accepts at most 32 inputs per request.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60

# ---- Supabase (Project Settings > API Keys)
# Use the publishable/secret keys, NOT the legacy anon/service_role JWT keys:
# those are deprecated, are no longer issued to new projects, and go away late 2026.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- MongoDB Atlas
# Standard SRV string with SCRAM auth, copied from the cluster's Connect dialog.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=aikti

# ---- RAG
RAG_MATCH_COUNT=5
RAG_MIN_SIMILARITY=0.25

# ---- Safety: surfaced verbatim whenever the red-flag agent escalates.
# Replace with your own verified numbers before deploying to real patients.
EMERGENCY_AMBULANCE=Rescue 1122
EMERGENCY_CONTACT_NOTE=If no ambulance is reachable, go to the nearest hospital emergency department immediately.

# ---- Tracing. Agent spans contain patient messages and lab values, so the
# SDK's default export to OpenAI is off. Trace ids are still generated and
# stored on every record, and the local console processor logs the tool chain.
TRACE_TO_OPENAI=false
TRACE_CONSOLE=true

# ---- Service
API_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
