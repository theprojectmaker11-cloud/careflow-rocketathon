# Server-side only. The browser never sees this URL — Next proxies every call
# through /api/*, which also means the backend address is not in the client bundle.
CAREFLOW_API_URL=http://127.0.0.1:8000

# Legacy name still honoured by lib/proxy.ts, so existing .env files keep working:
# AIKTI_API_URL=http://localhost:8000

# No AI provider key is needed in the browser. GEMINI_API_KEY lives exclusively in
# services/api/.env and is never sent to the client.
#
# No Supabase keys here either. The browser never talks to Supabase directly: all
# data access goes through the FastAPI service, which holds SUPABASE_SECRET_KEY
# server-side. Nothing in this app should carry a NEXT_PUBLIC_ key.
